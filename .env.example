# Either DATABASE_URL or the five PG* fields below is required.
DATABASE_URL=postgresql://chibbo_app:local-only@localhost:5432/chibbo
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=chibbo
# PGUSER=chibbo_app
# PGPASSWORD=local-only
CHIBBO_STORAGE_MODE=local
CHIBBO_LOCAL_STORAGE_DIR=.local-storage
CHIBBO_DELETION_PEPPER=replace-with-a-secret-manager-value
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
